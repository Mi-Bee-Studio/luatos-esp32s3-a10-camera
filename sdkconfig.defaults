# PSRAM disabled - unstable on this board (timing tuning fails, causes boot loop)
# Camera uses DRAM framebuffer (CAMERA_FB_IN_DRAM, fb_count=1)
# CONFIG_SPIRAM is not set

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Task Watchdog
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Event task stack (increase for WiFi callback chain)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_MAX_TASK_NAME_LEN=16
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_KEEPALIVE_DELAY=1000

# lwIP — 2026-09-03 EMFILE 事故（同 seeed 病根）：被堆门槛拒绝的浏览器按退避重连，
# 每次 503+close 留 TIME_WAIT 插座；默认 10 插座 + MSL 60s → 表打满，httpd 无法
# accept，/api/status 间歇空响应。插座 10→16，TIME_WAIT 120s→30s。
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_MSL=15000


# WiFi - disable WPA3 to prevent SAE auth issues (AMPDU disabled bypasses stall)
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_H2E is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set

# WiFi - AMPDU TX/RX disabled 2026-09-09: family weak-link default (PIT-039
# lesson ①, n16r8/ai recipe). 2026-09-09 判别实验：切到 1 米外 GT 系主节点（ch7，
# n16r8 同位置完美）失聪依旧（20 请求 8/20 与 GT 网完全同款，ping 与 TCP
# 同生共死）→ 网络侧无罪，板侧 TX 楔死。luatos 历史上 AMPDU 开启正是
# "驱动 stall" 的嫌疑源（2026-09-03 曾为绕 stall 关过，后因 HT40/-70dBm
# 弱信号下关 AMPDU 链路崩塌而重开）。现在驻留 GT 系主节点 -57dBm HT20 强链，
# 按 PIT-039 配方关闭验证。若关闭后失聪消失即定案；若需吞吐可再评估。
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set

# MiBeeCam feature flags (compile-time enable/disable)
CONFIG_MIBEECAM_ENABLE_WEBHOOK=y
CONFIG_MIBEECAM_ENABLE_ONVIF=y
CONFIG_MIBEECAM_ENABLE_WS=y
CONFIG_MIBEECAM_ENABLE_FRAME_BROADCASTER=y
CONFIG_MIBEECAM_ENABLE_BACKUP_SSID=y
CONFIG_MIBEECAM_ENABLE_MDNS=y
CONFIG_MIBEECAM_ENABLE_WIFI_SCAN=y
# ESPectre CSI 运动感知（2026-09-06 家族推广，PIT-034）：栅格 pps 是链路预算，
# 四仓统一 10（拥塞/弱链路下 admitted 才能过 70% 槽占用下限）。
CONFIG_ESPECTRE_CSI_TARGET_PPS=10

# PIT-038 Anti-stranding lwIP TCP tuning (tight-heap board): aborted transfer's dead
# connection would pin the entire TCP_SND_BUF in the retransmission black hole (measured: one
# mid-transfer death strands >10KB → heap drops to min 200B → send:113 storm).
# 4×MSS send buffer cap + halved retransmission count, dead connections are torn down within ~1 minute,
# throughput is sufficient for gzipped UI (17KB).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_MAXRTX=6
CONFIG_LWIP_TCP_SYNMAXRTX=6
